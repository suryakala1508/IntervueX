# Copy to .env and adjust. Every value here is the default the app already uses,
# so an empty .env is a working development configuration.

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# PostgreSQL is the production target. For a zero-infrastructure local run you
# can point this at SQLite instead:
#   DATABASE_URL=sqlite:///./intervuex.db
DATABASE_URL=postgresql+psycopg2://intervuex:intervuex@localhost:5432/intervuex

# --- Auth ---
# REQUIRED in production - the app refuses to boot with the default value.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM ---
# auto | anthropic | groq | offline
# "auto" prefers Anthropic, then Groq, then falls back to the deterministic
# offline provider. With no key at all the whole product still works, with
# rule-based questions and grading instead of model-generated ones.
LLM_PROVIDER=auto

# Option 1: Anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# Option 2: Groq - free tier, OpenAI-compatible. Get a key at console.groq.com.
# The model must support strict json_schema output; the product depends on
# structured responses. openai/gpt-oss-120b does.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Embeddings ---
# auto | voyage | hashing
# Embeddings power document retrieval, and are a SEPARATE service from the chat
# model - Groq does not offer them. Without a Voyage key, retrieval uses a local
# hashing embedder: no network, no cost, lower semantic quality (it matches
# shared wording rather than shared meaning). The stored dimension is fixed at
# 1024 either way, so switching later needs a re-index, not a migration.
EMBEDDING_PROVIDER=auto
VOYAGE_API_KEY=

# --- Vector search ---
# auto | pgvector | fallback. "fallback" computes cosine similarity in Python,
# which is what lets the app run on a PostgreSQL build without the extension.
VECTOR_BACKEND=auto

# --- Interview ---
DEFAULT_QUESTION_COUNT=8
