# Where the API lives. Leave empty for local development: the Vite dev server
# proxies /api to http://localhost:8000, so no CORS setup is needed.
#
# For a deployed frontend, set this to the API's public origin, e.g.
#   VITE_API_BASE_URL=https://intervuex-api.onrender.com
#
# Vite inlines VITE_* variables at BUILD time, so changing this needs a rebuild.
VITE_API_BASE_URL=
